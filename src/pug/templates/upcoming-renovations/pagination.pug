.upcoming-renovations-pagination__top(data-renovations-pagination)
	.upcoming-renovations-pagination__rows
		span.upcoming-renovations-pagination__rows-label Filas por página:
		.upcoming-renovations-pagination__rows-select-wrap
			select.upcoming-renovations-pagination__rows-select(data-pagination-size)
				option 1
				option 2
				option 3
				option 4
				option 5
				option 6
				option 7
				option 8
				option 9
				option(selected) 10
			span.icon-arrow-right.upcoming-renovations-pagination__rows-icon
.upcoming-renovations-pagination__bottom
	.upcoming-renovations-pagination__page
		span.upcoming-renovations-pagination__page-label Página
		span.upcoming-renovations-pagination__page-status(data-pagination-status) 1 de 10
	.upcoming-renovations-pagination__actions
		button.upcoming-renovations-pagination__button.upcoming-renovations-pagination__button--first(type="button" data-pagination-first aria-label="Ir a la primera página")
			span.icon-skip-left
		button.upcoming-renovations-pagination__button.upcoming-renovations-pagination__button--prev(type="button" data-pagination-prev aria-label="Ir a la página anterior")
			span.icon-back
		button.upcoming-renovations-pagination__button.upcoming-renovations-pagination__button--next(type="button" data-pagination-next aria-label="Ir a la página siguiente")
			span.icon-arrow-right
		button.upcoming-renovations-pagination__button.upcoming-renovations-pagination__button--last(type="button" data-pagination-last aria-label="Ir a la última página")
			span.icon-skip-right
