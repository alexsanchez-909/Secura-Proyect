.header__container
  .navbar
    .left-side 
      a(href="home.html")
        img(src="images/secura-insurance_logo.png", alt="logo")
      a(href="home.html") Inicio
      a(href="upcoming-renovations.html") Próximas renovaciones

    .right-side

      // Dropdown Perfil
      .dropdown
        button.dropdown-toggle(type="button")
          span.icon-user
          span.button-text Mi perfil
          span.icon-arrow-dropdown
        include dropdown-profile.pug
      // Dropdown Idioma
      .dropdown
        button.dropdown-toggle(type="button")
          span.icon-globe
          span.button-text Español
          span.icon-arrow-dropdown
        include dropdown-language.pug
      .dropdown.dropdown-burger
        button.dropdown-toggle(type="button")
          span.icon-burger_menu
        include dropdown-burger.pug
        
          
