extends layouts/layout-home

block vars
    - var pageTitle = "Homepage";

block header
    title Homepage
    
block content
    .home 
        include templates/home/homepage-banner.pug
        .home-wrapper
            section.home-section
                h2.renovations-tittle Próximas renovaciones
                .renovations-desktop
                    include templates/home/renovations-home.pug
                .home-renovations__actions
                    button.home-renovations__view-all(type="button") Ver todos
                    
            section.home-section
                h2.clients-tittle Clientes potenciales
                .potencial-clients
                    include templates/home/potencial-clients.pug
